# Server
PORT=3001

# PostgreSQL (sesuaikan dengan kredensial lokal kamu)
PGHOST=localhost
PGPORT=5432
PGDATABASE=listra_db
PGUSER=postgres
PGPASSWORD=postgres

# Cloudflare Turnstile (centang "bukan robot" di form testimoni publik).
# Kosong = pakai kunci uji Cloudflare yang selalu lolos (hanya untuk development).
# Production: isi dengan secret key dari dashboard Cloudflare > Turnstile.
TURNSTILE_SECRET_KEY=

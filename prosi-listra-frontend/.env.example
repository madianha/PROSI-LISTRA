# Salin menjadi .env lalu isi sesuai kebutuhan.

VITE_TINYMCE_API_KEY=

# Cloudflare Turnstile (centang "bukan robot" di form testimoni publik).
# Kosong = pakai kunci uji Cloudflare yang selalu lolos (hanya untuk development).
# Production: isi dengan site key dari dashboard Cloudflare > Turnstile.
VITE_TURNSTILE_SITE_KEY=
